# Kasa Exporter Configuration
KASA_USERNAME=your_kasa_username
KASA_PASSWORD=your_kasa_password

# Metrics Configuration
METRICS_PORT=9200

# Time-of-Use Cost Calculation
# Timezone for TOU rate calculations (default: America/Los_Angeles)
# Use standard IANA timezone names (e.g., America/New_York, Europe/London, Asia/Tokyo)
TZ=America/Los_Angeles

# Push Gateway Configuration
PUSH_GATEWAY_HOST=pushgateway
PUSH_GATEWAY_PORT=9091
PUSH_GATEWAY_DISABLED=false

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=your_secure_password_here

# mDNS Network Interface (for macvlan network)
MDNS_INTERFACE=eno1
