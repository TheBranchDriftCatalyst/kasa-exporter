<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kasa-exporter</string>

    <key>ProgramArguments</key>
    <array>
        <string>VENV_PATH/bin/python</string>
        <string>-m</string>
        <string>kasa_exporter</string>
    </array>

    <key>WorkingDirectory</key>
    <string>INSTALL_PATH</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>VENV_PATH/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- KASA_USERNAME and KASA_PASSWORD will be added during installation -->
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>INSTALL_PATH/logs/kasa-exporter.log</string>

    <key>StandardErrorPath</key>
    <string>INSTALL_PATH/logs/kasa-exporter-error.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
