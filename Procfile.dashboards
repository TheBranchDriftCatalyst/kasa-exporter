# Procfile for dashboard development with live reload
# Usage: foreman start -f Procfile.dashboards

# Dashboard watcher (Vite - auto-rebuild dashboards on panel changes)
dashboards: yarn watch

# Kasa Exporter with live reload
exporter: poetry run uvicorn kasa_exporter.__main__:app --reload --host 0.0.0.0 --port 9201
