                    {
                      "color": "#FF1694",
                      "value": null
                    },
                    {
                      "color": "#FFEA00",
                      "value": -70
                    },
                    {
                      "color": "#00FF9F",
                      "value": -50
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
