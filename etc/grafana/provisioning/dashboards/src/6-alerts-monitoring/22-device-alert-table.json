      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 57
      },
      "id": 22,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Alert"
          }
        ]
      },
      "pluginVersion": "10.2.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "state{version=~\"$version\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "current_consumption{version=~\"$version\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rssi{version=~\"$version\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "title": "📊 Device Alert Table",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "alias",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "version": true
            },
            "indexByName": {},
            "renameByName": {
              "Value #A": "State",
              "Value #B": "Power (W)",
              "Value #C": "RSSI",
              "alias": "Device"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "binary": {
              "left": "State",
              "operator": "==",
              "reducer": "sum",
              "right": "0"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            },
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Device": 0,
              "State": 1,
              "Power (W)": 2,
              "RSSI": 3,
              "State == 0": 4
            },
            "renameByName": {
              "State == 0": "Alert"
            }
          }
        }
      ],
      "type": "table"
    }
  ]
