      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 90
      },
      "id": 808,
      "options": {
        "legend": {
          "calcs": ["mean", "min", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 - ((sum(current_consumption{alias=~\"$device\", version=~\"$version\"}) / ($battery_voltage * $battery_capacity_ah * $inverter_efficiency)) * 100 * (time() % 86400) / 3600)",
          "legendFormat": "Battery Discharge (Load Only)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "clamp_max(vector((($solar_panel_watts * $inverter_efficiency) / ($battery_voltage * $battery_capacity_ah)) * 100 * (time() % 86400) / 3600), 100)",
          "legendFormat": "Battery Charge (Solar Only)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "clamp_max(clamp_min(100 + ((($solar_panel_watts * $inverter_efficiency) - sum(current_consumption{alias=~\"$device\", version=~\"$version\"})) / ($battery_voltage * $battery_capacity_ah * $inverter_efficiency)) * 100 * (time() % 86400) / 3600, 0), 100)",
          "legendFormat": "Net Battery State",
          "refId": "C"
        }
      ],
      "title": "📈 Battery State of Charge Timeline",
      "type": "timeseries"
    }
  ]
